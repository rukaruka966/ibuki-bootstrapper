{
  "schemaVersion": 4,
  "id": "web-hono",
  "version": "0.2.0",
  "displayName": "Web: React + Hono",
  "projectRequirements": [
    {
      "id": "node",
      "command": "node",
      "versionArguments": ["--version"],
      "minimumVersion": "24.10.0",
      "versionPattern": "v?(\\d+\\.\\d+\\.\\d+)"
    },
    {
      "id": "pnpm",
      "command": "pnpm",
      "versionArguments": ["--version"],
      "minimumVersion": "11.0.0",
      "versionPattern": "(\\d+\\.\\d+\\.\\d+)"
    }
  ],
  "recommendedCommands": [
    { "command": "pnpm", "arguments": ["install", "--frozen-lockfile"], "workingDirectory": "." },
    { "command": "pnpm", "arguments": ["run", "lint"], "workingDirectory": "." },
    { "command": "pnpm", "arguments": ["run", "test"], "workingDirectory": "." },
    { "command": "pnpm", "arguments": ["run", "typecheck"], "workingDirectory": "." },
    { "command": "pnpm", "arguments": ["run", "build"], "workingDirectory": "." },
    { "command": "pnpm", "arguments": ["run", "doctor"], "workingDirectory": "." }
  ],
  "files": [
    { "kind": "text", "source": "template/.env.example.tpl", "target": ".env.example", "template": true },
    { "kind": "text", "source": "template/.gitattributes.tpl", "target": ".gitattributes", "template": false },
    { "kind": "text", "source": "template/.gitignore.tpl", "target": ".gitignore", "template": false },
    { "kind": "text", "source": "template/.markdownlint.json.tpl", "target": ".markdownlint.json", "template": false },
    { "kind": "text", "source": "template/AGENTS.md.tpl", "target": "AGENTS.md", "template": true },
    { "kind": "text", "source": "template/DESIGN.md.tpl", "target": "DESIGN.md", "template": false },
    { "kind": "text", "source": "template/README.md.tpl", "target": "README.md", "template": true },
    { "kind": "text", "source": "template/docs/ja-JP/AGENTS-ja.md.tpl", "target": "docs/ja-JP/AGENTS-ja.md", "template": true },
    { "kind": "text", "source": "template/docs/ja-JP/DESIGN-ja.md.tpl", "target": "docs/ja-JP/DESIGN-ja.md", "template": false },
    { "kind": "text", "source": "template/package.json.tpl", "target": "package.json", "template": true },
    { "kind": "text", "source": "template/pnpm-workspace.yaml.tpl", "target": "pnpm-workspace.yaml", "template": false },
    { "kind": "text", "source": "template/pnpm-lock.yaml.tpl", "target": "pnpm-lock.yaml", "template": false },
    { "kind": "text", "source": "template/project.config.yaml.tpl", "target": "project.config.yaml", "template": true },
    { "kind": "text", "source": "template/tsconfig.base.json.tpl", "target": "tsconfig.base.json", "template": false },
    { "kind": "text", "source": "template/.github/workflows/ci.yml.tpl", "target": ".github/workflows/ci.yml", "template": false },
    { "kind": "text", "source": "template/scripts/doctor.ps1.tpl", "target": "scripts/doctor.ps1", "template": false },
    { "kind": "text", "source": "template/scripts/check-pr-branch-policy.mjs.tpl", "target": "scripts/check-pr-branch-policy.mjs", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/package.json.tpl", "target": "systems/web-frontend/package.json", "template": true },
    { "kind": "text", "source": "template/systems/web-frontend/tsconfig.json.tpl", "target": "systems/web-frontend/tsconfig.json", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/vite.config.ts.tpl", "target": "systems/web-frontend/vite.config.ts", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/index.html.tpl", "target": "systems/web-frontend/index.html", "template": true },
    { "kind": "text", "source": "template/systems/web-frontend/src/vite-env.d.ts.tpl", "target": "systems/web-frontend/src/vite-env.d.ts", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/src/main.tsx.tpl", "target": "systems/web-frontend/src/main.tsx", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/src/App.tsx.tpl", "target": "systems/web-frontend/src/App.tsx", "template": true },
    { "kind": "text", "source": "template/systems/web-frontend/src/App.test.tsx.tpl", "target": "systems/web-frontend/src/App.test.tsx", "template": true },
    { "kind": "text", "source": "template/systems/web-frontend/src/styles.css.tpl", "target": "systems/web-frontend/src/styles.css", "template": false },
    { "kind": "text", "source": "template/systems/web-frontend/src/test/setup.ts.tpl", "target": "systems/web-frontend/src/test/setup.ts", "template": false },
    { "kind": "text", "source": "template/systems/api-bff/package.json.tpl", "target": "systems/api-bff/package.json", "template": true },
    { "kind": "text", "source": "template/systems/api-bff/tsconfig.json.tpl", "target": "systems/api-bff/tsconfig.json", "template": false },
    { "kind": "text", "source": "template/systems/api-bff/src/app.ts.tpl", "target": "systems/api-bff/src/app.ts", "template": false },
    { "kind": "text", "source": "template/systems/api-bff/src/index.ts.tpl", "target": "systems/api-bff/src/index.ts", "template": false },
    { "kind": "text", "source": "template/systems/api-bff/src/app.test.ts.tpl", "target": "systems/api-bff/src/app.test.ts", "template": false }
  ]
}
